<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF7F7F9" />
            <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#FFF2F2F7" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF6E6E73" />
            <SolidColorBrush x:Key="OutlineBrush" Color="#FFE5E5EA" />
            <SolidColorBrush x:Key="SkeletonBrush" Color="#FFE5E5EA" />
            <Color x:Key="TopFadeStrongColor">#F0FFFFFF</Color>
            <Color x:Key="TopFadeMiddleColor">#A6FFFFFF</Color>
            <Color x:Key="BottomFadeStrongColor">#E6FFFFFF</Color>
            <SolidColorBrush x:Key="FloatingBarBrush" Color="#D9F7F7F9" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FF0D0D0F" />
            <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#FF1C1C1E" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF8E8E93" />
            <SolidColorBrush x:Key="OutlineBrush" Color="#FF2C2C2E" />
            <SolidColorBrush x:Key="SkeletonBrush" Color="#FF242426" />
            <Color x:Key="TopFadeStrongColor">#F0000000</Color>
            <Color x:Key="TopFadeMiddleColor">#A6000000</Color>
            <Color x:Key="BottomFadeStrongColor">#E6000000</Color>
            <SolidColorBrush x:Key="FloatingBarBrush" Color="#D90D0D0F" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="AccentBrush" Color="#FFFA2D48" />
    <SolidColorBrush x:Key="AccentWashBrush" Color="#24FA2D48" />

    <FontFamily x:Key="RegularFont">ms-appx:///Assets/Fonts/sf_pro_display_regular.otf#SF Pro Display</FontFamily>
    <FontFamily x:Key="MediumFont">ms-appx:///Assets/Fonts/sf_pro_display_medium.otf#SF Pro Display</FontFamily>
    <FontFamily x:Key="SemiboldFont">ms-appx:///Assets/Fonts/sf_pro_display_semibold.otf#SF Pro Display</FontFamily>
    <FontFamily x:Key="BoldFont">ms-appx:///Assets/Fonts/sf_pro_display_bold.otf#SF Pro Display</FontFamily>
    <FontFamily x:Key="HeavyFont">ms-appx:///Assets/Fonts/sf_pro_display_heavy.otf#SF Pro Display</FontFamily>

    <!-- CRITICAL: Force FontIcon to always use Segoe icon fonts so custom text fonts don't corrupt glyphs -->
    <Style TargetType="FontIcon">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="DisplayTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeavyFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="CharacterSpacing" Value="-24" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BoldFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="CharacterSpacing" Value="-18" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="TitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SemiboldFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CharacterSpacing" Value="-12" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RegularFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>

    <Style x:Key="SkeletonCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SkeletonBrush}" />
    </Style>

</ResourceDictionary>
