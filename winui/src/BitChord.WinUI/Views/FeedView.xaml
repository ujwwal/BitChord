<UserControl
    x:Class="BitChord.WinUI.Views.FeedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BitChord.WinUI">

    <UserControl.Resources>
        <!-- ── Hero card (landscape 16:10) ─────────────────────────────────── -->
        <DataTemplate x:Key="HeroCardTemplate" x:DataType="vm:FeedCard">
            <Border Width="280" Height="175" Margin="0,0,16,0"
                    Background="Transparent"
                    CornerRadius="18"
                    Tapped="Card_Tapped"
                    IsHitTestVisible="True">
                <Grid CornerRadius="18">
                    <!-- Surface placeholder background -->
                    <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="18" />

                    <!-- Real music note placeholder icon -->
                    <FontIcon Glyph="&#xE8D6;"
                              FontSize="38"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="{StaticResource AccentBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="{x:Bind PlaceholderVisibility, Mode=OneTime}" />

                    <!-- Live Artwork Image -->
                    <Image Source="{x:Bind ThumbnailUrl, Mode=OneTime}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Visibility="{x:Bind ThumbnailVisibility, Mode=OneTime}" />

                    <!-- Bottom gradient scrim + text overlay -->
                    <Grid VerticalAlignment="Bottom" CornerRadius="0,0,18,18" IsHitTestVisible="False">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Offset="0" Color="#00000000" />
                                <GradientStop Offset="0.4" Color="#80000000" />
                                <GradientStop Offset="1" Color="#E6000000" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <StackPanel Padding="14,24,14,14">
                            <TextBlock Text="{x:Bind Title}"
                                       FontFamily="{StaticResource SemiboldFont}"
                                       FontSize="15"
                                       CharacterSpacing="-10"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock Text="{x:Bind Subtitle}"
                                       FontFamily="{StaticResource RegularFont}"
                                       FontSize="13"
                                       Foreground="#B3FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Compact card (square) ───────────────────────────────────────── -->
        <DataTemplate x:Key="CompactCardTemplate" x:DataType="vm:FeedCard">
            <Border Width="150" Margin="0,0,16,0"
                    Background="Transparent"
                    Tapped="Card_Tapped"
                    IsHitTestVisible="True">
                <StackPanel Spacing="6">
                    <Grid Height="150" CornerRadius="14">
                        <!-- Surface background -->
                        <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="14" />

                        <!-- Placeholder icon -->
                        <FontIcon Glyph="&#xE8D6;"
                              FontSize="34"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="{StaticResource AccentBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="{x:Bind PlaceholderVisibility, Mode=OneTime}" />

                        <!-- Live Artwork Image -->
                        <Image Source="{x:Bind ThumbnailUrl, Mode=OneTime}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               Visibility="{x:Bind ThumbnailVisibility, Mode=OneTime}">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,150,150" />
                            </Image.Clip>
                        </Image>
                    </Grid>

                    <TextBlock Text="{x:Bind Title}"
                               Style="{StaticResource TitleStyle}"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                    <TextBlock Text="{x:Bind Subtitle}"
                               Style="{StaticResource BodyStyle}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,12,24,130" HorizontalAlignment="Stretch">
            <TextBlock x:Name="Heading" Margin="0,0,0,20" Style="{StaticResource DisplayTitleStyle}" />

            <ItemsControl x:Name="SectionsHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FeedSection">
                        <StackPanel Margin="0,0,0,28">
                            <TextBlock Margin="0,0,0,12"
                                       Text="{x:Bind Title}"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <!-- Hero row (landscape cards) -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Visibility="{x:Bind HeroVisibility, Mode=OneTime}">
                                <ItemsRepeater ItemsSource="{x:Bind Cards}"
                                               ItemTemplate="{StaticResource HeroCardTemplate}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </ScrollViewer>

                            <!-- Compact row (square cards) -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Visibility="{x:Bind CompactVisibility, Mode=OneTime}">
                                <ItemsRepeater ItemsSource="{x:Bind Cards}"
                                               ItemTemplate="{StaticResource CompactCardTemplate}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
