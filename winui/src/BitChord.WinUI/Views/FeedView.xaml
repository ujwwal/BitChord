<UserControl
    x:Class="BitChord.WinUI.Views.FeedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BitChord.WinUI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="0,8,0,26">
            <TextBlock x:Name="Heading" Margin="10,0,10,18" Style="{StaticResource DisplayTitleStyle}" />

            <ItemsControl x:Name="SectionsHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FeedSection">
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Margin="10,0,10,10"
                                       Text="{x:Bind Title}"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <ItemsRepeater ItemsSource="{x:Bind Cards}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FeedCard">
                                            <StackPanel Width="150" Spacing="8" Margin="0,0,14,0">
                                                <Border Height="150"
                                                        Background="{ThemeResource SurfaceVariantBrush}"
                                                        CornerRadius="12">
                                                    <Grid>
                                                        <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" />
                                                        <FontIcon Glyph="&#xE87C;"
                                                                  FontSize="30"
                                                                  Foreground="{StaticResource AccentBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource TitleStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}"
                                                           Style="{StaticResource BodyStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
