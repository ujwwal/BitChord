<UserControl
    x:Class="BitChord.WinUI.Views.FeedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="0,8,0,26">
            <TextBlock x:Name="Heading" Margin="10,0,10,18" Style="{StaticResource DisplayTitleStyle}" />

            <StackPanel x:Name="SkeletonPanel">
                <Border Width="190" Height="18" Margin="10,10,10,10" HorizontalAlignment="Left" CornerRadius="9" Style="{StaticResource SkeletonCardStyle}" />
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="10,0,10,26">
                        <Border Width="320" Height="348" CornerRadius="18" Style="{StaticResource SkeletonCardStyle}" />
                        <Border Width="320" Height="348" CornerRadius="18" Style="{StaticResource SkeletonCardStyle}" />
                    </StackPanel>
                </ScrollViewer>

                <Border Width="172" Height="18" Margin="10,10,10,10" HorizontalAlignment="Left" CornerRadius="9" Style="{StaticResource SkeletonCardStyle}" />
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="10,0,10,26">
                        <StackPanel Width="150" Spacing="9">
                            <Border Height="150" CornerRadius="12" Style="{StaticResource SkeletonCardStyle}" />
                            <Border Width="122" Height="13" HorizontalAlignment="Left" CornerRadius="7" Style="{StaticResource SkeletonCardStyle}" />
                            <Border Width="88" Height="11" HorizontalAlignment="Left" CornerRadius="6" Style="{StaticResource SkeletonCardStyle}" />
                        </StackPanel>
                        <StackPanel Width="150" Spacing="9">
                            <Border Height="150" CornerRadius="12" Style="{StaticResource SkeletonCardStyle}" />
                            <Border Width="106" Height="13" HorizontalAlignment="Left" CornerRadius="7" Style="{StaticResource SkeletonCardStyle}" />
                            <Border Width="116" Height="11" HorizontalAlignment="Left" CornerRadius="6" Style="{StaticResource SkeletonCardStyle}" />
                        </StackPanel>
                        <StackPanel Width="150" Spacing="9">
                            <Border Height="150" CornerRadius="12" Style="{StaticResource SkeletonCardStyle}" />
                            <Border Width="136" Height="13" HorizontalAlignment="Left" CornerRadius="7" Style="{StaticResource SkeletonCardStyle}" />
                            <Border Width="74" Height="11" HorizontalAlignment="Left" CornerRadius="6" Style="{StaticResource SkeletonCardStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Width="204" Height="18" Margin="10,10,10,10" HorizontalAlignment="Left" CornerRadius="9" Style="{StaticResource SkeletonCardStyle}" />
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="10,0,10,26">
                        <Border Width="150" Height="150" CornerRadius="12" Style="{StaticResource SkeletonCardStyle}" />
                        <Border Width="150" Height="150" CornerRadius="12" Style="{StaticResource SkeletonCardStyle}" />
                        <Border Width="150" Height="150" CornerRadius="12" Style="{StaticResource SkeletonCardStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
