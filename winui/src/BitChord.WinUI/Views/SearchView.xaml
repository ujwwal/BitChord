<UserControl
    x:Class="BitChord.WinUI.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <AutoSuggestBox x:Name="SearchBox"
                        Grid.Row="0"
                        Height="46"
                        Margin="10,0,10,4"
                        Padding="8,0,12,0"
                        Background="{ThemeResource SurfaceVariantBrush}"
                        BorderThickness="0"
                        CornerRadius="11"
                        FontFamily="{StaticResource RegularFont}"
                        FontSize="16"
                        PlaceholderText="Search">
            <AutoSuggestBox.QueryIcon>
                <FontIcon Glyph="&#xE721;" FontSize="18" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <TextBlock Grid.Row="1"
                   Margin="22,48"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   FontFamily="{StaticResource RegularFont}"
                   FontSize="16"
                   Foreground="{ThemeResource SecondaryTextBrush}"
                   Text="Search millions of songs on YouTube Music."
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
