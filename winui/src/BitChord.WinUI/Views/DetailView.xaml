<UserControl
    x:Class="BitChord.WinUI.Views.DetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BitChord.WinUI"
    xmlns:core="using:BitChord.Core">

    <UserControl.Resources>
        <!-- Track row template for album / playlist -->
        <DataTemplate x:Key="DetailTrackTemplate" x:DataType="core:Song">
            <Border Margin="0,2,0,2"
                    Padding="12,8"
                    Background="Transparent"
                    CornerRadius="10"
                    Tapped="Track_Tapped"
                    IsHitTestVisible="True">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Play icon / index -->
                    <Border Grid.Column="0" Width="36" Height="36" Background="#1AFFFFFF" CornerRadius="18">
                        <FontIcon Glyph="&#xE768;" FontSize="13"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  Foreground="{StaticResource AccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Title & Artist -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}"
                                   FontFamily="{StaticResource SemiboldFont}"
                                   FontSize="14"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <TextBlock Text="{x:Bind Artist}"
                                   FontFamily="{StaticResource RegularFont}"
                                   FontSize="12"
                                   Foreground="#99FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </StackPanel>

                    <!-- Duration / More -->
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind DurationText}"
                               FontFamily="{StaticResource RegularFont}"
                               FontSize="12"
                               Foreground="#80FFFFFF"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,16,24,130" HorizontalAlignment="Stretch" MaxWidth="900">
            <!-- 1. Top Navigation Bar: Back button -->
            <Grid Margin="0,0,0,16">
                <Button Width="40" Height="40"
                        Padding="0"
                        Background="#1AFFFFFF"
                        BorderThickness="0"
                        CornerRadius="20"
                        Click="Back_Click"
                        ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="15"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="White" />
                </Button>

                <TextBlock x:Name="HeaderTypeLabel"
                           Text="{x:Bind ViewModel.CurrentDetailPage.Subtitle, Mode=OneWay}"
                           FontFamily="{StaticResource SemiboldFont}"
                           FontSize="13"
                           Foreground="#99FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 2. Hero Header Zone -->
            <Grid Margin="0,10,0,24" ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- High-res Artwork Sleeve -->
                <Border Grid.Column="0" Width="200" Height="200"
                        Background="{ThemeResource SurfaceVariantBrush}"
                        CornerRadius="18">
                    <Grid CornerRadius="18">
                        <FontIcon Glyph="&#xE8D6;" FontSize="48"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  Foreground="{StaticResource AccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <Image Source="{x:Bind ViewModel.CurrentDetailPage.ThumbnailUrl, Mode=OneWay}"
                               Width="200" Height="200"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,200,200" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>

                <!-- Title, Subtitle, Description & Action Buttons -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.CurrentDetailPage.Title, Mode=OneWay}"
                               FontFamily="{StaticResource BoldFont}"
                               FontSize="26"
                               Foreground="White"
                               TextWrapping="Wrap"
                               MaxLines="2" />

                    <TextBlock Text="{x:Bind ViewModel.CurrentDetailPage.Subtitle, Mode=OneWay}"
                               FontFamily="{StaticResource SemiboldFont}"
                               FontSize="14"
                               Foreground="{StaticResource AccentBrush}" />

                    <TextBlock Text="{x:Bind ViewModel.CurrentDetailPage.Description, Mode=OneWay}"
                               FontFamily="{StaticResource RegularFont}"
                               FontSize="13"
                               Foreground="#B3FFFFFF"
                               TextWrapping="Wrap"
                               MaxLines="3"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Action Buttons: Play All, Shuffle, Search Filter -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button Height="44" Padding="24,0"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="22"
                                Click="PlayAll_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                <TextBlock Text="Play" FontFamily="{StaticResource SemiboldFont}" FontSize="14" />
                            </StackPanel>
                        </Button>

                        <Button Width="44" Height="44" Padding="0"
                                Background="#1AFFFFFF"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="22"
                                Click="Shuffle_Click"
                                ToolTipService.ToolTip="Shuffle">
                            <FontIcon Glyph="&#xE8B1;" FontSize="16"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Loading Spinner -->
            <ProgressRing IsActive="{x:Bind ViewModel.CurrentDetailPage.IsLoading, Mode=OneWay}"
                          Width="40" Height="40"
                          HorizontalAlignment="Center"
                          Margin="0,30,0,30"
                          Visibility="{x:Bind ViewModel.CurrentDetailPage.IsLoading, Mode=OneWay}" />

            <!-- 3. Track List (Songs) -->
            <TextBlock Text="Tracks"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,10,0,12" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentDetailPage.Songs, Mode=OneWay}"
                          ItemTemplate="{StaticResource DetailTrackTemplate}" />

            <!-- 4. Sections (e.g. Albums / Singles on Artist Page) -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentDetailPage.Sections, Mode=OneWay}"
                          Margin="0,20,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FeedSection">
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0,0,0,12" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{x:Bind Cards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FeedCard">
                                            <Border Width="140" Margin="0,0,14,0"
                                                    Background="Transparent"
                                                    Tapped="Card_Tapped"
                                                    IsHitTestVisible="True">
                                                <StackPanel Spacing="6">
                                                    <Grid Height="140" CornerRadius="12">
                                                        <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" />
                                                        <Image Source="{x:Bind ThumbnailUrl, Mode=OneTime}"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Stretch">
                                                            <Image.Clip>
                                                                <RectangleGeometry Rect="0,0,140,140" />
                                                            </Image.Clip>
                                                        </Image>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Title}"
                                                               Style="{StaticResource TitleStyle}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind Subtitle}"
                                                               Style="{StaticResource BodyStyle}"
                                                               FontSize="11"
                                                               Foreground="#99FFFFFF"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
