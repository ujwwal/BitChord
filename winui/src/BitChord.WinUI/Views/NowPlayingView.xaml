<UserControl
    x:Class="BitChord.WinUI.Views.NowPlayingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BitChord.WinUI"
    xmlns:core="using:BitChord.Core">

    <Grid Background="#F50C0C12">
        <!-- ── Dynamic Ambient Background Artwork Layer ──────────────────────── -->
        <Image Source="{x:Bind ViewModel.CurrentSong.ThumbnailUrl, Mode=OneWay}"
               Stretch="UniformToFill"
               Opacity="0.28"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- ── Motion Canvas Video Layer (Tidal / Spotify Canvas) ─────────────── -->
        <MediaPlayerElement x:Name="CanvasVideoPlayer"
                            AutoPlay="True"
                            AreTransportControlsEnabled="False"
                            Stretch="UniformToFill"
                            Opacity="0.45"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Visibility="{x:Bind GetCanvasVisibility(ViewModel.HasCanvas), Mode=OneWay}" />

        <!-- ── Multi-Stop Mesh Gradient Backdrop Scrim ──────────────────────── -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="#E60D0D14" />
                    <GradientStop Offset="0.35" Color="#D9140E1B" />
                    <GradientStop Offset="0.7" Color="#F00A0A10" />
                    <GradientStop Offset="1" Color="#FC06060A" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ── Main Player Container ────────────────────────────────────────── -->
        <Grid MaxWidth="600"
              Padding="24,12,24,16"
              HorizontalAlignment="Center"
              VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: Top Header & View Mode Switcher -->
                <RowDefinition Height="*" />    <!-- 1: Center Dynamic Content (Artwork / Lyrics / Queue) -->
                <RowDefinition Height="Auto" /> <!-- 2: Bottom Fixed Controls & Scrubber -->
            </Grid.RowDefinitions>

            <!-- ── 0. Top Header ────────────────────────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,4,0,10">
                <!-- Dismiss Chevron Button -->
                <Button HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="40" Height="40"
                        Padding="0"
                        Background="#1AFFFFFF"
                        BorderThickness="0"
                        CornerRadius="20"
                        Click="Dismiss_Click"
                        ToolTipService.ToolTip="Collapse Now Playing">
                    <FontIcon Glyph="&#xE70D;" FontSize="16"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="White" />
                </Button>

                <!-- Center Mode Switcher Capsule (Artwork / Lyrics / Queue) -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#26FFFFFF"
                        CornerRadius="18"
                        Padding="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- Artwork Mode Button -->
                        <Button x:Name="ModeArtworkBtn"
                                Width="36" Height="28" Padding="0"
                                Background="{x:Bind GetModeBackground(ViewModel.ActiveNowPlayingMode, 0), Mode=OneWay}"
                                BorderThickness="0" CornerRadius="14"
                                Click="ModeArtwork_Click"
                                ToolTipService.ToolTip="Cover Artwork">
                            <FontIcon Glyph="&#xEB9F;" FontSize="13"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                      Foreground="{x:Bind GetModeForeground(ViewModel.ActiveNowPlayingMode, 0), Mode=OneWay}" />
                        </Button>

                        <!-- Lyrics Mode Button -->
                        <Button x:Name="ModeLyricsBtn"
                                Width="36" Height="28" Padding="0"
                                Background="{x:Bind GetModeBackground(ViewModel.ActiveNowPlayingMode, 1), Mode=OneWay}"
                                BorderThickness="0" CornerRadius="14"
                                Click="ModeLyrics_Click"
                                ToolTipService.ToolTip="Synced Lyrics">
                            <FontIcon Glyph="&#xEC4F;" FontSize="13"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                      Foreground="{x:Bind GetModeForeground(ViewModel.ActiveNowPlayingMode, 1), Mode=OneWay}" />
                        </Button>

                        <!-- Queue Mode Button -->
                        <Button x:Name="ModeQueueBtn"
                                Width="36" Height="28" Padding="0"
                                Background="{x:Bind GetModeBackground(ViewModel.ActiveNowPlayingMode, 2), Mode=OneWay}"
                                BorderThickness="0" CornerRadius="14"
                                Click="ModeQueue_Click"
                                ToolTipService.ToolTip="Playback Queue">
                            <FontIcon Glyph="&#xE90B;" FontSize="13"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                      Foreground="{x:Bind GetModeForeground(ViewModel.ActiveNowPlayingMode, 2), Mode=OneWay}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Close Button -->
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="40" Height="40"
                        Padding="0"
                        Background="#1AFFFFFF"
                        BorderThickness="0"
                        CornerRadius="20"
                        Click="Dismiss_Click"
                        ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="14"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="White" />
                </Button>
            </Grid>

            <!-- ── 1. Center Content Switcher ───────────────────────────────── -->
            <Grid Grid.Row="1" Margin="0,4,0,8">
                <!-- 1A: Artwork Mode View -->
                <Grid Visibility="{x:Bind ViewModel.IsArtworkMode, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Large Album Artwork Sleeve -->
                    <Border Grid.Row="0"
                            Width="310" Height="310"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SurfaceVariantBrush}"
                            CornerRadius="24">
                        <Grid CornerRadius="24">
                            <FontIcon Glyph="&#xE8D6;" FontSize="64"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                      Foreground="{StaticResource AccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <Image Source="{x:Bind ViewModel.CurrentSong.ThumbnailUrl, Mode=OneWay}"
                                   Width="310" Height="310"
                                   Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,310,310" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <!-- Track Title & Artist with Like Button -->
                    <Grid Grid.Row="1" Margin="12,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.CurrentSong.Title, Mode=OneWay}"
                                       FontFamily="{StaticResource BoldFont}"
                                       FontSize="22"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentSong.Artist, Mode=OneWay}"
                                       FontFamily="{StaticResource RegularFont}"
                                       FontSize="15"
                                       Foreground="#B3FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       Tapped="Artist_Tapped"
                                       IsHitTestVisible="True" />
                        </StackPanel>

                        <!-- Like Heart Button -->
                        <Button Grid.Column="1"
                                Width="44" Height="44"
                                Padding="0"
                                Background="#1FFFFFFF"
                                BorderThickness="0"
                                CornerRadius="22"
                                Click="Like_Click"
                                ToolTipService.ToolTip="Like track">
                            <FontIcon Glyph="{x:Bind GetLikeGlyph(ViewModel.IsLiked), Mode=OneWay}"
                                      FontSize="19"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                      Foreground="{x:Bind GetLikeBrush(ViewModel.IsLiked), Mode=OneWay}" />
                        </Button>
                    </Grid>

                    <!-- Live Lyrics Preview Capsule ("Tap for lyrics >") -->
                    <Border Grid.Row="2"
                            Margin="12,0,12,6"
                            Padding="14,9"
                            Background="#1AFFFFFF"
                            CornerRadius="14"
                            Tapped="LyricsPreview_Tapped"
                            IsHitTestVisible="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.LyricsSnippet, Mode=OneWay}"
                                       FontFamily="{StaticResource SemiboldFont}"
                                       FontSize="13"
                                       Foreground="#E6FFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                      Foreground="#B3FFFFFF" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 1B: Synced Lyrics View (Apple Music Style Glow & Auto-Scroll) -->
                <Grid Visibility="{x:Bind ViewModel.IsLyricsMode, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Synchronized Lyrics"
                               FontFamily="{StaticResource SemiboldFont}"
                               FontSize="13"
                               Foreground="#80FFFFFF"
                               Margin="16,0,0,8" />

                    <!-- Loading state -->
                    <ProgressRing Grid.Row="1"
                                  IsActive="{x:Bind ViewModel.IsLyricsLoading, Mode=OneWay}"
                                  Width="40" Height="40"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="{x:Bind ViewModel.IsLyricsLoading, Mode=OneWay}" />

                    <!-- Empty / Unavailable state -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="{x:Bind GetLyricsUnavailableVisibility(ViewModel.ActiveLyricsState), Mode=OneWay}">
                        <FontIcon Glyph="&#xEC4F;" FontSize="32"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  Foreground="#66FFFFFF"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No lyrics available for this song"
                                   FontFamily="{StaticResource SemiboldFont}"
                                   FontSize="15"
                                   Foreground="#80FFFFFF"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <!-- Synced Lyrics Scroll List -->
                    <ScrollViewer x:Name="LyricsScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,10,8,60">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveLyrics, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LyricLineUiModel">
                                    <Border Margin="0,4,0,4"
                                            Padding="14,10"
                                            Background="Transparent"
                                            CornerRadius="14"
                                            Tapped="LyricLine_Tapped"
                                            IsHitTestVisible="True">
                                        <TextBlock Text="{x:Bind Text}"
                                                   FontFamily="{StaticResource BoldFont}"
                                                   FontSize="24"
                                                   LineHeight="34"
                                                   TextWrapping="Wrap"
                                                   Foreground="White"
                                                   FontWeight="{x:Bind FontWeight, Mode=OneWay}"
                                                   Opacity="{x:Bind LineOpacity, Mode=OneWay}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 1C: Up Next Queue View -->
                <Grid Visibility="{x:Bind ViewModel.IsQueueMode, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,0,12,8">
                        <TextBlock Text="Up Next Queue"
                                   FontFamily="{StaticResource SemiboldFont}"
                                   FontSize="14"
                                   Foreground="#B3FFFFFF"
                                   VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                Padding="12,4"
                                Background="#1AFFFFFF"
                                BorderThickness="0"
                                CornerRadius="12"
                                Click="ClearQueue_Click">
                            <TextBlock Text="Clear" FontFamily="{StaticResource SemiboldFont}" FontSize="12" Foreground="#E6FFFFFF" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveQueue, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:Song">
                                    <Border Margin="0,3,0,3"
                                            Padding="12,8"
                                            Background="Transparent"
                                            CornerRadius="10"
                                            Tapped="QueueItem_Tapped"
                                            IsHitTestVisible="True">
                                        <Grid ColumnSpacing="12">
                                             <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Thumbnail -->
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#26FFFFFF">
                                                <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                                            </Border>

                                            <!-- Title & Artist -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontFamily="{StaticResource SemiboldFont}"
                                                           FontSize="13"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                                <TextBlock Text="{x:Bind Artist}"
                                                           FontFamily="{StaticResource RegularFont}"
                                                           FontSize="11"
                                                           Foreground="#99FFFFFF"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                            </StackPanel>

                                            <!-- Remove button -->
                                            <Button Grid.Column="2"
                                                    Width="32" Height="32" Padding="0"
                                                    Background="Transparent" BorderThickness="0" CornerRadius="16"
                                                    Click="RemoveQueueItem_Click"
                                                    ToolTipService.ToolTip="Remove from queue">
                                                <FontIcon Glyph="&#xE711;" FontSize="11"
                                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                          Foreground="#80FFFFFF" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ── 2. Fixed Bottom Controls & Scrubber ──────────────────────── -->
            <StackPanel Grid.Row="2" Margin="12,0,12,4" Spacing="8">
                <!-- Progress Scrubber & Times -->
                <StackPanel Spacing="2">
                    <Slider Value="{x:Bind ViewModel.Progress, Mode=TwoWay}"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.001"
                            Margin="0,0,0,0" />
                    <Grid Margin="2,0,2,0">
                        <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}"
                                   FontFamily="{StaticResource RegularFont}"
                                   FontSize="12"
                                   Foreground="#99FFFFFF"
                                   HorizontalAlignment="Left" />

                        <TextBlock Text="{x:Bind ViewModel.AudioQualityBadge, Mode=OneWay}"
                                   FontFamily="{StaticResource SemiboldFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}"
                                   FontFamily="{StaticResource RegularFont}"
                                   FontSize="12"
                                   Foreground="#99FFFFFF"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- Transport Playback Controls -->
                <Grid HorizontalAlignment="Center" ColumnSpacing="28" Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Previous Button -->
                    <Button Grid.Column="0"
                            Width="52" Height="52"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="26"
                            Click="Prev_Click"
                            ToolTipService.ToolTip="Previous">
                        <FontIcon Glyph="&#xE892;" FontSize="22"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  Foreground="White" />
                    </Button>

                    <!-- Giant Play / Pause Button -->
                    <Button Grid.Column="1"
                            Width="68" Height="68"
                            Padding="0"
                            Background="White"
                            BorderThickness="0"
                            CornerRadius="34"
                            Click="PlayPause_Click"
                            ToolTipService.ToolTip="Play/Pause">
                        <FontIcon Glyph="{x:Bind GetPlayPauseGlyph(ViewModel.IsPlaying), Mode=OneWay}"
                                  FontSize="26"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  Foreground="Black" />
                    </Button>

                    <!-- Next Button -->
                    <Button Grid.Column="2"
                            Width="52" Height="52"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="26"
                            Click="Next_Click"
                            ToolTipService.ToolTip="Next">
                        <FontIcon Glyph="&#xE893;" FontSize="22"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  Foreground="White" />
                    </Button>
                </Grid>

                <!-- Volume Slider Capsule -->
                <Grid ColumnSpacing="10" VerticalAlignment="Center" Margin="16,0,16,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE74F;" FontSize="14"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="#80FFFFFF" />

                    <Slider Grid.Column="1"
                            Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.01" />

                    <FontIcon Grid.Column="2" Glyph="&#xE767;" FontSize="14"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="#80FFFFFF" />
                </Grid>

                <!-- Bottom Pills (Shuffle, Repeat, Autoplay) -->
                <Grid HorizontalAlignment="Stretch" Padding="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Shuffle -->
                    <Button Grid.Column="0"
                            HorizontalAlignment="Center"
                            Width="44" Height="44"
                            Padding="0"
                            Background="{x:Bind GetButtonActiveBrush(ViewModel.IsShuffled), Mode=OneWay}"
                            BorderThickness="0"
                            CornerRadius="22"
                            Click="Shuffle_Click"
                            ToolTipService.ToolTip="Shuffle">
                        <FontIcon Glyph="&#xE8B1;" FontSize="17"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  Foreground="{x:Bind GetButtonActiveForeground(ViewModel.IsShuffled), Mode=OneWay}" />
                    </Button>

                    <!-- Repeat Mode -->
                    <Button Grid.Column="1"
                            HorizontalAlignment="Center"
                            Width="44" Height="44"
                            Padding="0"
                            Background="{x:Bind GetRepeatActiveBrush(ViewModel.RepeatMode), Mode=OneWay}"
                            BorderThickness="0"
                            CornerRadius="22"
                            Click="Repeat_Click"
                            ToolTipService.ToolTip="Repeat mode">
                        <FontIcon Glyph="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}" FontSize="16"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  Foreground="{x:Bind GetRepeatActiveForeground(ViewModel.RepeatMode), Mode=OneWay}" />
                    </Button>

                    <!-- Autoplay -->
                    <Button Grid.Column="2"
                            HorizontalAlignment="Center"
                            Width="44" Height="44"
                            Padding="0"
                            Background="{x:Bind GetButtonActiveBrush(ViewModel.IsAutoplayEnabled), Mode=OneWay}"
                            BorderThickness="0"
                            CornerRadius="22"
                            Click="Autoplay_Click"
                            ToolTipService.ToolTip="Autoplay similar songs">
                        <FontIcon Glyph="&#xE7E8;" FontSize="18"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  Foreground="{x:Bind GetButtonActiveForeground(ViewModel.IsAutoplayEnabled), Mode=OneWay}" />
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
