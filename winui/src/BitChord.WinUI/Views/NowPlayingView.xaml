<UserControl
    x:Class="BitChord.WinUI.Views.NowPlayingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:BitChord.WinUI"
    mc:Ignorable="d">

    <Grid Background="#F00F0F14">
        <!-- Ambient blurred background artwork layer -->
        <Image Source="{x:Bind ViewModel.CurrentSong.ThumbnailUrl, Mode=OneWay}"
               Stretch="UniformToFill"
               Opacity="0.22"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- Gradient backdrop overlay -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="#D913131A" />
                    <GradientStop Offset="0.5" Color="#E6101016" />
                    <GradientStop Offset="1" Color="#FA08080C" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main container -->
        <Grid MaxWidth="540"
              Padding="24,16,24,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Header -->
                <RowDefinition Height="*" />    <!-- Artwork -->
                <RowDefinition Height="Auto" /> <!-- Title & Like -->
                <RowDefinition Height="Auto" /> <!-- Lyrics Preview -->
                <RowDefinition Height="Auto" /> <!-- Progress Bar & Time -->
                <RowDefinition Height="Auto" /> <!-- Main Controls -->
                <RowDefinition Height="Auto" /> <!-- Volume Slider -->
                <RowDefinition Height="Auto" /> <!-- Bottom Action Row -->
            </Grid.RowDefinitions>

            <!-- 1. Top Header -->
            <Grid Grid.Row="0" Margin="0,4,0,12">
                <Button HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="38" Height="38"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="19"
                        Click="Dismiss_Click"
                        ToolTipService.ToolTip="Collapse">
                    <FontIcon Glyph="&#xE70D;" FontSize="16"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="{ThemeResource PrimaryTextBrush}" />
                </Button>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Drag handle pill -->
                    <Border Width="36" Height="4" Margin="0,0,0,6"
                            Background="#40FFFFFF"
                            CornerRadius="2"
                            HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentSong.Title, Mode=OneWay}"
                               FontFamily="{StaticResource SemiboldFont}"
                               FontSize="14"
                               Foreground="#B3FFFFFF"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300" />
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="38" Height="38"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="19"
                        Click="Dismiss_Click"
                        ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="14"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="{ThemeResource PrimaryTextBrush}" />
                </Button>
            </Grid>

            <!-- 2. Large Album Artwork -->
            <Grid Grid.Row="1" Margin="0,10,0,16"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Border Width="320" Height="320"
                        Background="{ThemeResource SurfaceVariantBrush}"
                        CornerRadius="24">
                    <Grid CornerRadius="24">
                        <FontIcon Glyph="&#xE8D6;" FontSize="64"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  Foreground="{StaticResource AccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <Image Source="{x:Bind ViewModel.CurrentSong.ThumbnailUrl, Mode=OneWay}"
                               Width="320" Height="320"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,320,320" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Title, Artist & Like/More Buttons -->
            <Grid Grid.Row="2" Margin="0,8,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CurrentSong.Title, Mode=OneWay}"
                               FontFamily="{StaticResource BoldFont}"
                               FontSize="22"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentSong.Artist, Mode=OneWay}"
                               FontFamily="{StaticResource RegularFont}"
                               FontSize="15"
                               Foreground="#B3FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </StackPanel>

                <!-- Heart / Like Button -->
                <Button Grid.Column="1"
                        Width="42" Height="42"
                        Margin="0,0,6,0"
                        Padding="0"
                        Background="#1AFFFFFF"
                        BorderThickness="0"
                        CornerRadius="21"
                        Click="Like_Click"
                        ToolTipService.ToolTip="Like">
                    <FontIcon Glyph="{x:Bind GetLikeGlyph(ViewModel.IsLiked), Mode=OneWay}"
                              FontSize="18"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="{x:Bind GetLikeBrush(ViewModel.IsLiked), Mode=OneWay}" />
                </Button>

                <!-- More Options Button -->
                <Button Grid.Column="2"
                        Width="42" Height="42"
                        Padding="0"
                        Background="#1AFFFFFF"
                        BorderThickness="0"
                        CornerRadius="21"
                        Click="More_Click"
                        ToolTipService.ToolTip="More options">
                    <FontIcon Glyph="&#xE712;" FontSize="18"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="{ThemeResource PrimaryTextBrush}" />
                </Button>
            </Grid>

            <!-- 4. Live Lyrics Preview Capsule ("You count on me >") -->
            <Border Grid.Row="3"
                    Margin="0,4,0,14"
                    Padding="14,8"
                    Background="#1FFFFFFF"
                    CornerRadius="14"
                    Tapped="Lyrics_Tapped"
                    IsHitTestVisible="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.LyricsSnippet, Mode=OneWay}"
                               FontFamily="{StaticResource SemiboldFont}"
                               FontSize="13"
                               Foreground="#E6FFFFFF"
                               TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="#B3FFFFFF" />
                </Grid>
            </Border>

            <!-- 5. Progress Scrubber & Timing Indicators -->
            <StackPanel Grid.Row="4" Margin="0,0,0,10">
                <Slider Value="{x:Bind ViewModel.Progress, Mode=TwoWay}"
                        Minimum="0"
                        Maximum="1"
                        StepFrequency="0.001"
                        Margin="0,0,0,2"
                        ValueChanged="Slider_ValueChanged" />
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}"
                               FontFamily="{StaticResource RegularFont}"
                               FontSize="12"
                               Foreground="#99FFFFFF"
                               HorizontalAlignment="Left" />

                    <TextBlock Text="{x:Bind ViewModel.AudioQualityBadge, Mode=OneWay}"
                               FontFamily="{StaticResource SemiboldFont}"
                               FontSize="12"
                               Foreground="#CCFFFFFF"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}"
                               FontFamily="{StaticResource RegularFont}"
                               FontSize="12"
                               Foreground="#99FFFFFF"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <!-- 6. Main Playback Controls (Previous, Play/Pause, Next) -->
            <Grid Grid.Row="5" Margin="0,6,0,12" HorizontalAlignment="Center" ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Previous button -->
                <Button Grid.Column="0"
                        Width="52" Height="52"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="26"
                        Click="Prev_Click"
                        ToolTipService.ToolTip="Previous">
                    <FontIcon Glyph="&#xE892;" FontSize="22"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="White" />
                </Button>

                <!-- Giant Play / Pause Button -->
                <Button Grid.Column="1"
                        Width="68" Height="68"
                        Padding="0"
                        Background="White"
                        BorderThickness="0"
                        CornerRadius="34"
                        Click="PlayPause_Click"
                        ToolTipService.ToolTip="Play/Pause">
                    <FontIcon Glyph="{x:Bind GetPlayPauseGlyph(ViewModel.IsPlaying), Mode=OneWay}"
                              FontSize="26"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="Black" />
                </Button>

                <!-- Next button -->
                <Button Grid.Column="2"
                        Width="52" Height="52"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="26"
                        Click="Next_Click"
                        ToolTipService.ToolTip="Next">
                    <FontIcon Glyph="&#xE893;" FontSize="22"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="White" />
                </Button>
            </Grid>

            <!-- 7. Volume Slider with Icons -->
            <Grid Grid.Row="6" Margin="0,0,0,14" ColumnSpacing="10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE74F;" FontSize="15"
                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                          Foreground="#99FFFFFF" />

                <Slider Grid.Column="1"
                        Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                        Minimum="0"
                        Maximum="1"
                        StepFrequency="0.01" />

                <FontIcon Grid.Column="2" Glyph="&#xE767;" FontSize="15"
                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                          Foreground="#99FFFFFF" />
            </Grid>

            <!-- 8. Bottom Action Bar (Shuffle, Repeat, Autoplay, Queue) -->
            <Grid Grid.Row="7" HorizontalAlignment="Stretch" Padding="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Shuffle -->
                <Button Grid.Column="0"
                        HorizontalAlignment="Center"
                        Width="42" Height="42"
                        Padding="0"
                        Background="{x:Bind GetButtonActiveBrush(ViewModel.IsShuffled), Mode=OneWay}"
                        BorderThickness="0"
                        CornerRadius="21"
                        Click="Shuffle_Click"
                        ToolTipService.ToolTip="Shuffle">
                    <FontIcon Glyph="&#xE8B1;" FontSize="17"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="{x:Bind GetButtonActiveForeground(ViewModel.IsShuffled), Mode=OneWay}" />
                </Button>

                <!-- Repeat -->
                <Button Grid.Column="1"
                        HorizontalAlignment="Center"
                        Width="42" Height="42"
                        Padding="0"
                        Background="{x:Bind GetRepeatActiveBrush(ViewModel.RepeatMode), Mode=OneWay}"
                        BorderThickness="0"
                        CornerRadius="21"
                        Click="Repeat_Click"
                        ToolTipService.ToolTip="Repeat mode">
                    <FontIcon Glyph="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}" FontSize="16"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="{x:Bind GetRepeatActiveForeground(ViewModel.RepeatMode), Mode=OneWay}" />
                </Button>

                <!-- Autoplay -->
                <Button Grid.Column="2"
                        HorizontalAlignment="Center"
                        Width="42" Height="42"
                        Padding="0"
                        Background="{x:Bind GetButtonActiveBrush(ViewModel.IsAutoplayEnabled), Mode=OneWay}"
                        BorderThickness="0"
                        CornerRadius="21"
                        Click="Autoplay_Click"
                        ToolTipService.ToolTip="Autoplay similar songs">
                    <FontIcon Glyph="&#xE7E8;" FontSize="18"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="{x:Bind GetButtonActiveForeground(ViewModel.IsAutoplayEnabled), Mode=OneWay}" />
                </Button>

                <!-- Queue -->
                <Button Grid.Column="3"
                        HorizontalAlignment="Center"
                        Width="42" Height="42"
                        Padding="0"
                        Background="#1AFFFFFF"
                        BorderThickness="0"
                        CornerRadius="21"
                        Click="Queue_Click"
                        ToolTipService.ToolTip="Current Queue">
                    <FontIcon Glyph="&#xE90B;" FontSize="17"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              Foreground="{ThemeResource PrimaryTextBrush}" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
